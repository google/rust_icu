load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "ecma402_traits",
    srcs = glob(["src/**/*.rs"]),
    crate_features = [
        "renaming",
        "static",
        "icu_version_in_env",
