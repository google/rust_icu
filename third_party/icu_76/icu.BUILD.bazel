load("@rules_foreign_cc//foreign_cc:configure.bzl", "configure_make")

licenses(["notice"])

filegroup(
    name = "all",
    srcs = glob(["icu4c/**"]),
)

_CFLAGS = "-fPIC"

_CXXFLAGS = _CFLAGS

_SHARED_LIBS = [
    "libicui18n",
    "libicuio",
    "libicuuc",
    "libicudata",
]

# `@bazel_tools` is visible from every repository, including the ones the
# icu_deps extension generates with http_archive; `@platforms` is not.
_MACOS = "@bazel_tools//src/conditions:darwin"

configure_make(
    name = "icu",
    configure_command = "source/configure",
    configure_options = [
        "--enable-static",
        "--with-data-packaging=static",
    ],
    env = {
        "CXXFLAGS": _CXXFLAGS,
        "CFLAGS": _CFLAGS,
    },
    lib_source = "//:all",
    out_data_dirs = [
        "share",
    ],
    out_shared_libs = select({
        _MACOS: [lib + ".dylib" for lib in _SHARED_LIBS],
        "//conditions:default": [lib + ".so" for lib in _SHARED_LIBS],
    }),
    out_static_libs = [
        "libicui18n.a",
        "libicuio.a",
        "libicuuc.a",
        "libicudata.a",
    ],
    targets = ["install"],
    visibility = ["//visibility:public"],
)

exports_files(["icu4c/LICENSE"])

filegroup(
    name = "icudtl",
    srcs = ["share/icu/76.1/icudt76l.dat"],
    output_group = "gen_dir",
    visibility = ["//visibility:public"],
)
